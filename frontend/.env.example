# Copy this to .env.local and adjust as needed.
# When running against the dev proxy (npm run dev), leave this blank.
# Set to a full URL when pointing at a remote backend:
#   VITE_API_BASE=https://your-server.com
VITE_API_BASE=

# Phase 10 map (Mapbox GL JS). PUBLIC token only (pk.*), with a Mapbox
# dashboard URL restriction and scope limited to styles:tiles/styles:read.
# This is bundled into the browser JS by Vite's VITE_ prefix — that exposure
# is expected and unavoidable for a browser map token, which is exactly why
# the URL restriction is required before deploy.
#
# NEVER put the backend's MAPBOX_ACCESS_TOKEN (secret, sk.*, Directions API
# only) here — that token must only ever live in backend/.env, server-side.
# Two tokens, two lifecycles; do not share one between them.
#
# Left blank in dev, MapView renders an honest "map unavailable" state
# instead of guessing or falling back to a different map provider.
VITE_MAPBOX_TOKEN=

# Supabase Auth (plan 260814-supabase-auth-and-per-user-history). Both are
# PUBLIC by design — VITE_SUPABASE_ANON_KEY is the publishable anon key, safe
# to bundle into browser JS (same two-token discipline as Mapbox above; the
# backend's separate SUPABASE_SERVICE_KEY in backend/.env must never appear
# here). Get both from Supabase Dashboard -> Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
