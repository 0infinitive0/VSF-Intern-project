# Cloudflare Workers AI configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LLM_PROVIDER=cloudflare
LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
LLM_REASONING_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
LLM_FAST_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Cloudflare Workers AI embeddings
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=@cf/baai/bge-m3

# docker-compose.yml reads this from the root .env for the frontend build
# (frontend/Dockerfile ARG). PUBLIC Mapbox token only (pk.*, URL-restricted
# on the Mapbox dashboard) — never the backend's secret MAPBOX_ACCESS_TOKEN
# (that one goes in backend/.env). Leave blank to build with the map's honest
# "unavailable" placeholder instead of a broken map.
VITE_MAPBOX_TOKEN=
