# ============================================
# AI20K Project - Environment Variables
# ============================================
# Copy this file to .env for local development.
# Set production values in Railway service variables.
# NEVER commit real secrets to git.

# ---- LLM Configuration ----
OPENAI_API_KEY=
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# Local development defaults to SQLite.
DATABASE_URL=sqlite:///./data/app.db
# Railway Postgres, when provisioned later:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---- Vector Store (Qdrant) ----
# Local docker-compose Qdrant requires QDRANT_API_KEY to start at all (Phase 6
# — no unauthenticated fallback). Any non-empty value works locally; it's
# whatever the qdrant service is told to require via QDRANT__SERVICE__API_KEY
# in docker-compose.yml. The compose Qdrant is bound to 127.0.0.1 only — no
# TLS in front of it, so this key travels as a cleartext header; that's
# acceptable only because it's loopback-bound, not because the key alone
# secures it. For a hosted Qdrant Cloud cluster, use its real URL/API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- Embeddings (Ollama, self-hosted — no cloud equivalent) ----
OLLAMA_URL=http://localhost:11434

# ---- Supabase (hotels/rooms/attractions source of truth) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Vector Store (legacy/unused — kept for reference) ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Railway production example:
# APP_ENV=production
# CORS_ORIGINS=https://your-frontend.example.com

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
