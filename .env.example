# ============================================
# AI20K Project - Environment Variables
# ============================================
# Copy this file to .env for local development.
# Set production values in Railway service variables.
# NEVER commit real secrets to git.

# ---- LLM Configuration ----
OPENAI_API_KEY=
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# Local development defaults to SQLite.
DATABASE_URL=sqlite:///./data/app.db
# Railway Postgres, when provisioned later:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Railway production example:
# APP_ENV=production
# CORS_ORIGINS=https://your-frontend.example.com

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
