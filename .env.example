# ============================================
# AI20K Project - Environment Variables
# ============================================
# Copy this file to .env for local development.
# Set production values in Railway service variables.
# NEVER commit real secrets to git.

# ---- Chat LLM Configuration ----
# Default: Local Ollama (llama3.1)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0.3

# OpenAI Example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-proj-...

# Google Gemini Example:
# LLM_PROVIDER=google
# LLM_MODEL=gemini-1.5-flash
# LLM_API_KEY=AIzaSy...

# Anthropic Claude Example:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20240620
# LLM_API_KEY=sk-ant-...

# OpenRouter Example:
# LLM_PROVIDER=openrouter
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_API_KEY=sk-or-v1-...
# Note: OpenRouter's free-tier model roster changes often — check
# https://openrouter.ai/models?max_price=0 for what's currently available.

# Cloudflare Workers AI Example (OpenAI-compatible endpoint):
# LLM_PROVIDER=openai
# LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
# LLM_API_KEY=<Cloudflare API token with Workers AI permission>
# LLM_API_BASE=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1

# Mistral Example (OpenAI-compatible endpoint, has a free "Experiment" tier):
# LLM_PROVIDER=openai
# LLM_MODEL=mistral-small-latest
# LLM_API_KEY=<Mistral API key>
# LLM_API_BASE=https://api.mistral.ai/v1

# Legacy / Alternative OpenAI API Key & OpenRouter Key
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ---- Embedding Model Configuration ----
# Default: Local Ollama (bge-m3)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# OpenRouter bge-m3 Embedding Example:
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_MODEL=baai/bge-m3
# EMBEDDING_API_KEY=sk-or-v1-...

# OpenAI Embeddings Example:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-proj-...

# Google Embeddings Example:
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=models/text-embedding-004
# EMBEDDING_API_KEY=AIzaSy...
# WARNING: hotel/attraction vectors already stored in Supabase were embedded
# with bge-m3 (1024-dim). Switching EMBEDDING_MODEL to a different model
# (e.g. Google's text-embedding-004, 768-dim) breaks similarity search —
# only change WHERE bge-m3 runs, never swap the model itself.

# Cloudflare Workers AI bge-m3 Example (OpenAI-compatible endpoint, has a
# real free daily quota — 10,000 Neurons/day shared across models):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=@cf/baai/bge-m3
# EMBEDDING_API_KEY=<Cloudflare API token with Workers AI permission>
# EMBEDDING_API_BASE=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1

# ---- Supabase Credentials ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Database ----
# Local development defaults to SQLite.
DATABASE_URL=sqlite:///./data/app.db
# Railway Postgres, when provisioned later:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Railway production example:
# APP_ENV=production
# CORS_ORIGINS=https://your-frontend.example.com

# ---- Session Registry (Phase 3) ----
# TTL for in-memory chat sessions (seconds). Default: 2 hours.
SESSION_TTL_SECONDS=7200
# Hard cap on concurrent in-memory sessions. Default: 200.
MAX_SESSIONS=200
# If true, writes trip plan JSON to debug/{session_id}/ for debugging.
# Never enable in production.
DEBUG_TRIP_PLAN_FILE=false

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (React + Vite — runs separately) ----
# cd frontend && npm install && npm run dev
# Vite proxies /api → http://localhost:8000 automatically in dev.
# VITE_API_BASE=http://localhost:8000