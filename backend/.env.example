# ============================================
# Environment Variables
# ============================================
# Copy this file to .env for local development.
# NEVER commit real secrets to git.

# ---- Chat LLM Configuration ----
# Default: Cloudflare two-tier LLM routing (70B reasoning, 8B fast)
LLM_PROVIDER=ollama
LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
LLM_FAST_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0.3
# Reasoning effort for OpenAI gpt-5/o1/o3/o4-family models only (ignored by other
# models). minimal|low|medium|high. Lower = faster + fewer hidden reasoning tokens,
# at the cost of response depth on genuinely hard questions.
LLM_REASONING_EFFORT=low
# Route OpenAI calls through the Responses API instead of Chat Completions.
# On by default. Applies ONLY to LLM_PROVIDER=openai and ONLY to the reasoning
# family (gpt-5/o1/o3/o4): gpt-4o-mini answers the reasoning parameters this route
# implies with a 400, and it is the model the eval judge uses.
# Set it to false to roll back -- this variable, not a deploy.
LLM_USE_RESPONSES_API=true
# Ask the model to summarize its own reasoning, streamed as `reasoning` SSE frames.
# off | auto. Needs LLM_USE_RESPONSES_API=true -- Chat Completions has no channel for
# it. Coverage is unpredictable by design of the feature: a model summarizes only when
# it actually reasons, so a simple question yields nothing and a tool-calling step
# never yields anything. The text is ALWAYS English, even in a Vietnamese conversation.
LLM_REASONING_SUMMARY=off
JAILBREAK_GUARD_MODE=block

# ---- Graph node contracts ----
# strict: a contract violation raises. Keep this in dev and CI — it is what
#         stops a worker that finishes a turn without replying from merging.
# log:    the violation is logged at ERROR and the turn continues. Set this in
#         PRODUCTION: raising there costs the user their whole turn, which is
#         worse than the degraded reply the check exists to catch.
CONTRACT_ENFORCEMENT_MODE=strict

# ---- qa_node context window ----
# Token ceiling on the transcript qa_node sends to the model, applied before
# EVERY LLM call in its ReAct loop. It is the only node handed the whole
# conversation; every other prompt in the graph is one message plus structured
# facts, so only this one grows as a session runs long.
# Sized for COST, not for the model's window: gpt-5-mini's window dwarfs any
# realistic session, but each ReAct hop re-bills the whole transcript it is
# sent. Oldest messages drop first; the tools can re-read the real data.
QA_CONTEXT_TOKEN_BUDGET=30000

# OpenAI Example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-proj-...

# Google Gemini Example:
# LLM_PROVIDER=google
# LLM_MODEL=gemini-1.5-flash
# LLM_API_KEY=AIzaSy...

# Anthropic Claude Example:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20240620
# LLM_API_KEY=sk-ant-...

# OpenRouter Example:
# LLM_PROVIDER=openrouter
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_API_KEY=sk-or-v1-...
# Note: OpenRouter's free-tier model roster changes often — check
# https://openrouter.ai/models?max_price=0 for what's currently available.

# Cloudflare Workers AI Example (OpenAI-compatible endpoint):
# LLM_PROVIDER=openai
# LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
# LLM_API_KEY=<Cloudflare API token with Workers AI permission>
# LLM_API_BASE=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1

# Mistral Example (OpenAI-compatible endpoint, has a free "Experiment" tier):
# LLM_PROVIDER=openai
# LLM_MODEL=mistral-small-latest
# LLM_API_KEY=<Mistral API key>
# LLM_API_BASE=https://api.mistral.ai/v1

# Legacy / Alternative OpenAI API Key & OpenRouter Key
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ---- Embedding Model Configuration ----
# Default: Local Ollama (bge-m3)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# OpenRouter bge-m3 Embedding Example:
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_MODEL=baai/bge-m3
# EMBEDDING_API_KEY=sk-or-v1-...

# OpenAI Embeddings Example:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-proj-...

# Google Embeddings Example:
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=models/text-embedding-004
# EMBEDDING_API_KEY=AIzaSy...
# WARNING: hotel/attraction vectors already stored in Supabase were embedded
# with bge-m3 (1024-dim). Switching EMBEDDING_MODEL to a different model
# (e.g. Google's text-embedding-004, 768-dim) breaks similarity search —
# only change WHERE bge-m3 runs, never swap the model itself.

# Cloudflare Workers AI bge-m3 Example (OpenAI-compatible endpoint, has a
# real free daily quota — 10,000 Neurons/day shared across models):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=@cf/baai/bge-m3
# EMBEDDING_API_KEY=<Cloudflare API token with Workers AI permission>
# EMBEDDING_API_BASE=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1

# ---- Supabase Credentials ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Leave blank in normal use: JWT verification (src/auth/jwt_verifier.py) checks
# SUPABASE_URL's JWKS endpoint by default and needs no secret to do that — this
# is what THIS project's Supabase instance actually uses (confirmed 2026-08-14:
# it publishes a real ES256 key, not a legacy shared secret).
# Only set this if pointing the backend at an older Supabase project that still
# uses the legacy shared HS256 JWT secret (Dashboard -> Settings -> API -> JWT
# Settings). Never reuse SUPABASE_SERVICE_KEY here — that key is for the
# Postgres/PostgREST client only, unrelated to token verification.
SUPABASE_JWT_SECRET=

# ---- Mapbox Credentials ----
MAPBOX_ACCESS_TOKEN=

# ---- VNPay (plan 260818-vnpay-payment-and-email-confirmation) ----
# Register a sandbox merchant at https://sandbox.vnpayment.vn/devreg/ to get
# VNPAY_TMN_CODE + VNPAY_HASH_SECRET. In that same portal, configure the IPN
# URL (server-to-server payment confirmation -- not a request parameter) to
# point at https://<this-backend's-public-domain>/api/v1/payments/vnpay/ipn.
# localhost cannot receive it; use ngrok or similar for local testing.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Sandbox by default. Production: https://vnpayment.vn/paymentv2/vpcpay.html
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Frontend page VNPay redirects the browser back to (display only, never
# trusted for confirmation) -- e.g. https://your-frontend.example.com/
VNPAY_RETURN_URL=

# ---- Brevo (email confirmation) ----
# No domain/DNS needed: sign up at brevo.com (free tier), then Settings >
# Senders, Domains & Dedicated IPs > Senders > add BREVO_FROM_EMAIL below and
# click the confirmation link Brevo emails to it once. Get BREVO_API_KEY from
# Settings > SMTP & API > API Keys.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# ---- Database ----
# Local development defaults to SQLite.
DATABASE_URL=sqlite:///./data/app.db
# Railway Postgres, when provisioned later:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---- LangGraph Checkpointer ----
# Default: in-process, non-durable (state lost on restart).
CHECKPOINTER_BACKEND=memory
# To persist graph state across restarts, set CHECKPOINTER_BACKEND=postgres
# and provide a full connection string -- for Supabase, use the Supavisor
# pooler DSN from the dashboard (Settings -> Database -> Connection string ->
# Session pooler), NOT the direct db.<project_ref>.supabase.co host (that one
# is IPv4-deprecated / IPv6-only and unreachable from this project's
# Docker/EC2 deployment):
# CHECKPOINTER_DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Railway production example:
# APP_ENV=production
# CORS_ORIGINS=https://your-frontend.example.com

# ---- Session Registry (Phase 3) ----
# TTL for in-memory chat sessions (seconds). Default: 2 hours.
SESSION_TTL_SECONDS=7200
# Hard cap on concurrent in-memory sessions. Default: 200.
MAX_SESSIONS=200
# Persist session state and chat history to Supabase. Default: disabled.
SESSION_PERSISTENCE_ENABLED=false
# If true, writes trip plan JSON to debug/{session_id}/ for debugging.
# Never enable in production.
DEBUG_TRIP_PLAN_FILE=false

# ---- Auth (plan 260814-supabase-auth-and-per-user-history) ----
# If true, session-scoped endpoints reject requests with no/invalid Supabase JWT.
# Default: disabled, so the auth dependency can ship and be tested before any
# traffic is actually rejected. Flip only after confirming the frontend sends
# Authorization: Bearer <token> on every call.
AUTH_REQUIRED=false

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Tests ----
# Run the suite without reaching a hosted LLM. Nine tests open a live
# connection to api.openai.com; with this set they report as skipped instead of
# spending money, and `make test` drops from ~170s to ~100s. Everything else,
# Supabase included, still runs for real. A real environment variable overrides
# this file, so `TEST_SKIP_LLM=true make test` works as a one-off.
TEST_SKIP_LLM=false

# ---- Airflow admin client (plan 260824-1015-admin-dashboard-portal, phase 13) ----
# Backend-only credentials for the admin Pipeline screens (C1-C3) -- portal
# users never get an Airflow account of their own. Left empty by default: an
# empty AIRFLOW_API_BASE disables the whole pipeline branch (health reports
# connected:false, every other call raises AirflowUnavailable before any
# network request) rather than pointing at a host that may not exist.
#
# Airflow runs in its own compose stack (backend/src/airflow/docker-compose.yaml),
# not on this app's network. To enable it, pick ONE base URL depending on
# environment:
#   (a) Dev on macOS/Windows, both stacks on the same machine:
#       AIRFLOW_API_BASE=http://host.docker.internal:8088
#   (b) Staging, both stacks on the same machine/Linux host: add
#       `networks: {airflow_net: {external: true}}` to both compose files, then
#       AIRFLOW_API_BASE=http://airflow-apiserver:8080  (the compose *service*
#       name/alias -- not the project-derived container name, which breaks if
#       the directory is ever renamed)
#   (c) Prod, Airflow on a different host: AIRFLOW_API_BASE=https://airflow.internal...
#       (needs TLS + firewall -- not set up by this repo)
AIRFLOW_API_BASE=
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_REQUEST_TIMEOUT=10.0

# ---- Frontend (React + Vite — runs separately) ----
# cd frontend && npm install && npm run dev
# Vite proxies /api → http://localhost:8000 automatically in dev.
# VITE_API_BASE=http://localhost:8000
