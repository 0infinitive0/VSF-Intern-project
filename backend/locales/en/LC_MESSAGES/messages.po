msgid "SYSTEM ERROR: Thông tin thay đổi chuyến đi chưa đầy đủ."
msgstr "SYSTEM ERROR: Trip change information is incomplete."

msgid "Bạn muốn ngân sách khách sạn khoảng bao nhiêu?"
msgstr "What is your approximate hotel budget?"

msgid "SYSTEM ERROR: Không thể lưu danh sách khách sạn mới."
msgstr "SYSTEM ERROR: Could not save the new hotel list."

msgid "Vui lòng bổ sung thông tin chuyến đi."
msgstr "Please provide the missing trip information."

msgid "Kế hoạch đã xác nhận không thể chỉnh sửa. Hãy tạo một kế hoạch mới nếu cần thay đổi."
msgstr ""
"A confirmed plan cannot be edited. Please create a new plan if you need to make "
"changes."

msgid "SYSTEM ERROR: Yêu cầu thay đổi thông tin chuyến đi không hợp lệ."
msgstr "SYSTEM ERROR: The trip information change request is invalid."

#, python-brace-format
msgid "Mình chưa thể xác nhận thay đổi {exc} Bạn vui lòng nói rõ lại nhé."
msgstr "I could not confirm the change {exc} Please be more specific."

#, python-brace-format
msgid ""
"Mình chưa thể xác nhận {exc} Hãy chọn một sở thích được hỗ trợ hoặc nói rõ thông tin "
"muốn đổi."
msgstr ""
"I could not confirm {exc} Please pick a supported preference or clearly state what "
"you want to change."

msgid ""
"SYSTEM ERROR: Không thể hiểu an toàn yêu cầu chỉnh sửa này. Vui lòng diễn đạt cụ thể "
"hơn."
msgstr "SYSTEM ERROR: Could not safely understand this edit request. Please be more specific."

msgid "Bạn muốn chỉnh sửa phần nào của lịch trình?"
msgstr "Which part of the itinerary would you like to edit?"

msgid "SYSTEM ERROR: Không thể áp dụng yêu cầu chỉnh sửa này."
msgstr "SYSTEM ERROR: Could not apply this edit request."

msgid "SYSTEM ERROR: Chưa có kế hoạch để xác nhận. Hãy tạo kế hoạch trước."
msgstr "SYSTEM ERROR: There is no plan to confirm. Please create a plan first."

msgid "Bạn cần chọn khách sạn trước khi xác nhận lịch trình."
msgstr "You need to choose a hotel before confirming the itinerary."

msgid "Đã xác nhận lịch trình. Phần tìm kiếm tái sử dụng sẽ tự thử lại sau."
msgstr "Itinerary confirmed. The reuse search will retry automatically later."

msgid "Đã xác nhận lịch trình và lưu làm mẫu có thể tái sử dụng."
msgstr "Itinerary confirmed and saved as a reusable template."

msgid "SYSTEM ERROR: Chưa có kế hoạch chuyến đi để chỉnh sửa."
msgstr "SYSTEM ERROR: There is no trip plan to edit."

msgid "Bạn cần chọn khách sạn trước khi chỉnh sửa lịch trình."
msgstr "You need to choose a hotel before editing the itinerary."

msgid "Yêu cầu này không thay đổi lịch trình hiện tại."
msgstr "This request does not change the current itinerary."

msgid ""
"SYSTEM ERROR: Cần có ngày bắt đầu và ngày kết thúc hợp lệ (YYYY-MM-DD) để tìm khách "
"sạn."
msgstr "SYSTEM ERROR: Valid start and end dates (YYYY-MM-DD) are required to find hotels."

msgid "SYSTEM ERROR: Ngày kết thúc phải sau ngày bắt đầu."
msgstr "SYSTEM ERROR: The end date must be after the start date."

#, python-brace-format
msgid "SYSTEM ERROR: Không tìm thấy dữ liệu điểm đến cho {dest}."
msgstr "SYSTEM ERROR: No destination data found for {dest}."

#, python-brace-format
msgid ""
"SYSTEM ERROR: Không tìm thấy khách sạn có tọa độ hợp lệ tại {dest}; không thể gợi ý "
"khách sạn."
msgstr "SYSTEM ERROR: No hotel with valid coordinates found at {dest}; cannot suggest hotels."

msgid "SYSTEM ERROR: Chưa có danh sách khách sạn nào để chọn. Hãy tạo gợi ý khách sạn trước."
msgstr ""
"SYSTEM ERROR: There is no hotel list to choose from. Please generate hotel "
"suggestions first."

#, python-brace-format
msgid ""
"Mình chưa xác định được đúng khách sạn bạn muốn chọn, bạn trả lời rõ hơn giúp mình "
"nhé (số thứ tự hoặc tên khách sạn).\n"
"------\n"
"{options}"
msgstr ""
"I could not determine which hotel you want. Please reply more clearly (a number or a "
"hotel name).\n"
"------\n"
"{options}"

msgid "SYSTEM ERROR: Không còn kế hoạch chuyến đi để đổi khách sạn."
msgstr "SYSTEM ERROR: There is no longer a trip plan to change the hotel."

msgid "Đã đổi khách sạn và lập lại toàn bộ các cụm địa điểm theo vị trí mới."
msgstr "Changed the hotel and rebuilt all the location clusters around the new location."

msgid "Đã cập nhật thông tin chuyến đi, chọn lại khách sạn và lập một lịch trình mới."
msgstr "Updated the trip information, reselected the hotel, and built a new itinerary."

msgid "Khách sạn chưa xác định"
msgstr "Undetermined hotel"

#, python-brace-format
msgid " ({star_rating} sao)"
msgstr " ({star_rating} stars)"

#, python-brace-format
msgid " | Phòng gợi ý: {rooms}"
msgstr " | Suggested rooms: {rooms}"

#, python-brace-format
msgid "Tóm tắt: {description}"
msgstr "Summary: {description}"

#, python-brace-format
msgid "Ngày {day_num}{theme_suffix}:"
msgstr "Day {day_num}{theme_suffix}:"

msgid "Tham quan điểm du lịch"
msgstr "Visit tourist spot"

msgid "Chưa có hoạt động hợp lệ cho ngày này."
msgstr "No valid activities for this day."

msgid "Điều chỉnh tự động:"
msgstr "Automatic adjustments:"

msgid "Không tìm thấy khách sạn phù hợp. Bạn thử mô tả khác hoặc đổi điểm đến xem sao."
msgstr "No matching hotels found. Try a different description or destination."

msgid "Mình tìm được vài khách sạn phù hợp, bạn chọn giúp mình nhé:"
msgstr "I found some matching hotels, please pick one:"

#, python-brace-format
msgid " | Đánh giá: {review_score}/10"
msgstr " | Rating: {review_score}/10"

#, python-brace-format
msgid " ({review_count} lượt)"
msgstr " ({review_count} reviews)"

#, python-brace-format
msgid " | {price:,.0f} {currency}/đêm"
msgstr " | {price:,.0f} {currency}/night"

#, python-brace-format
msgid " · Tổng {nights} đêm: {total:,.0f} {currency}"
msgstr " · Total for {nights} nights: {total:,.0f} {currency}"

#, python-brace-format
msgid " | {price} {currency}/đêm"
msgstr " | {price} {currency}/night"

#, python-brace-format
msgid " | Giá từ: {price:,.0f} {currency}"
msgstr " | From: {price:,.0f} {currency}"

#, python-brace-format
msgid " | Giá từ: {price} {currency}"
msgstr " | From: {price} {currency}"

#, python-brace-format
msgid "   Phòng gợi ý: {rooms}"
msgstr "   Suggested rooms: {rooms}"

#, python-brace-format
msgid "   Bữa ăn đã bao gồm: {meals}"
msgstr "   Meals included: {meals}"

msgid "Trả lời bằng số thứ tự hoặc tên khách sạn để chọn."
msgstr "Reply with a number or a hotel name to choose."

#, python-brace-format
msgid "Bạn muốn đi đâu? Hiện mình có dữ liệu cho: {choices}."
msgstr "Where would you like to go? I currently have data for: {choices}."

msgid "Bạn muốn đi đâu?"
msgstr "Where would you like to go?"

msgid "Bạn dự định đi trong bao lâu?"
msgstr "How long do you plan to travel?"

msgid "Bạn dự định bắt đầu chuyến đi vào ngày nào?"
msgstr "When do you plan to start your trip?"

msgid "Tuyệt vời. Chuyến đi này có bao nhiêu người tham gia?"
msgstr "Great! How many people are joining this trip?"

#, python-brace-format
msgid "Không tìm thấy dữ liệu điểm đến cho {destination}."
msgstr "No destination data found for {destination}."

msgid "Khách sạn đã chọn thiếu tọa độ hợp lệ; không thể lập lịch trình."
msgstr "The selected hotel lacks valid coordinates; cannot build an itinerary."

#, python-brace-format
msgid ""
"Không tìm thấy khách sạn có tọa độ hợp lệ tại {destination}; không thể lập lịch trình"
" theo vị trí khách sạn."
msgstr ""
"No hotel with valid coordinates found at {destination}; cannot build an itinerary "
"around the hotel location."

msgid "SYSTEM ERROR: Không tìm thấy khách sạn với id đã cho tại điểm đến này."
msgstr "SYSTEM ERROR: No hotel found with the given id at this destination."

msgid "Đã xảy ra lỗi phía máy chủ. Vui lòng thử lại."
msgstr "A server error occurred. Please try again."

msgid ""
"Bạn muốn mức giá khách sạn khoảng nào? Trả lời bằng số gợi ý bên dưới, hoặc cứ nói "
"thẳng mức giá bạn muốn (vd \"4 triệu\"):"
msgstr ""
"What hotel price range are you looking for? Reply with one of the numbered options "
"below, or just tell me a price directly (e.g. \"4 million\"):"

msgid "Bạn dự định kết thúc chuyến đi vào ngày nào?"
msgstr "When do you plan to end your trip?"

#, python-brace-format
msgid "Bạn muốn nói ngày {raw} năm nào? Cho mình biết năm cụ thể nhé."
msgstr "Which year did you mean for {raw}? Please tell me the specific year."

#, python-brace-format
msgid ""
"Ngày {raw} bạn nói có thể hiểu theo hai cách. Trả lời 1 hoặc 2:\n"
"1. {a}\n"
"2. {b}"
msgstr ""
"The date {raw} you mentioned could be read two ways. Reply 1 or 2:\n"
"1. {a}\n"
"2. {b}"

msgid ""
"Bạn muốn mức giá khách sạn khoảng nào? Có thể nói một mức cụ thể (vd \"4 triệu/đêm\"),"
" một khoảng (vd \"2-3 triệu/đêm\"), hoặc \"không cần lọc theo giá\" nếu bạn không có "
"yêu cầu."
msgstr ""
"What hotel price range are you looking for? You can name a specific price (e.g. "
"\"4 million/night\"), a range (e.g. \"2-3 million/night\"), or say \"no price "
"preference\" if you don't have one."

#, python-brace-format
msgid "Đã cập nhật: {joined}."
msgstr "Updated: {joined}."

msgid "Mình chưa hiểu rõ ý bạn ở câu trả lời trước."
msgstr "I didn't quite catch your previous reply."

msgid "chi phí hoạt động"
msgstr "activity costs"

msgid "chi phí khách sạn"
msgstr "hotel costs"

#, python-brace-format
msgid "Phần chiếm nhiều nhất là {dominant}."
msgstr "The largest share is {dominant}."

msgid "Không thể tính ngân sách mỗi đêm vì chưa có thông tin số đêm lưu trú."
msgstr "Could not compute a per-night budget because the number of nights is unknown."

#, python-brace-format
msgid ""
"Chi phí hoạt động đã vượt tổng ngân sách {total:,.0f} VND — không còn "
"ngân sách cho khách sạn."
msgstr ""
"Activity costs already exceed the total budget of {total:,.0f} VND — no "
"budget left for a hotel."

msgid "Không thể xác định điểm đến để tìm lại khách sạn."
msgstr "Could not determine the destination to search hotels again."

#, python-brace-format
msgid "Tìm khách sạn trong ngân sách {ceiling:,.0f} VND/đêm thất bại: {exc}"
msgstr "Hotel search within {ceiling:,.0f} VND/night failed: {exc}"

#, python-brace-format
msgid ""
"Không tìm thấy khách sạn nào trong mức {ceiling:,.0f} VND/đêm tại "
"{destination}."
msgstr "No hotel found within {ceiling:,.0f} VND/night in {destination}."

#, python-brace-format
msgid "Không tìm được khách sạn rẻ hơn: {error}"
msgstr "Could not find a cheaper hotel: {error}"

#, python-brace-format
msgid "Ngày {day}"
msgstr "Day {day}"

#, python-brace-format
msgid "Đã điều chỉnh sang khách sạn {hotel} để phù hợp ngân sách. "
msgstr "Switched to hotel {hotel} to fit the budget. "

msgid "Đã điều chỉnh khách sạn để phù hợp ngân sách. "
msgstr "Adjusted the hotel to fit the budget. "

#, python-brace-format
msgid ""
"Sau khi tìm khách sạn rẻ hơn, tổng chi phí vẫn là {known:,.0f} VND (ngân "
"sách {total:,.0f} VND, vượt {shortfall:,.0f} VND). Phần chiếm nhiều nhất "
"là {dominant}."
msgstr ""
"After searching for a cheaper hotel, the total cost is still {known:,.0f} "
"VND (budget {total:,.0f} VND, over by {shortfall:,.0f} VND). The largest "
"share is {dominant}."

#, python-brace-format
msgid "Ngân sách toàn chuyến: {total:,.0f} VND (chưa có đủ giá để kiểm tra)."
msgstr "Whole-trip budget: {total:,.0f} VND (not enough price data to check)."

#, python-brace-format
msgid " ({covered}/{all} mục có giá — có thể còn chi phí chưa biết)"
msgstr " ({covered}/{all} items priced — actual cost may be higher)"

#, python-brace-format
msgid ""
"Ngân sách toàn chuyến: {known:,.0f} / {total:,.0f} VND (trong ngân "
"sách){coverage}."
msgstr "Whole-trip budget: {known:,.0f} / {total:,.0f} VND (within budget){coverage}."

#, python-brace-format
msgid ""
"Ngân sách toàn chuyến: {known:,.0f} / {total:,.0f} VND (VƯỢT "
"{shortfall:,.0f} VND){coverage}."
msgstr "Whole-trip budget: {known:,.0f} / {total:,.0f} VND (OVER by {shortfall:,.0f} VND){coverage}."

msgid "Bạn dự định đi và về ngày nào?"
msgstr "When do you plan to depart and return?"

msgid ""
"Lịch trình này đã được hoàn tất và khoá lại nên mình không thể chỉnh sửa "
"được nữa. Bạn vẫn có thể hỏi mình về chuyến đi, hoặc nhân bản thành một "
"chuyến đi mới nếu muốn thay đổi."
msgstr ""
"This itinerary has been finalized and locked, so I can't edit it anymore. "
"You can still ask me about your trip, or duplicate it into a new trip if "
"you'd like to make changes."
